{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/main"
    },
    {
      "source": "/api/copilot",
      "destination": "/api/copilot.js"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/main"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/main"
    },
    {
      "source": "/splash",
      "destination": "/splash.html"
    }
  ]
}
