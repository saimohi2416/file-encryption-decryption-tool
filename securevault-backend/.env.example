# SecureVault AI Environment Configuration Example
# Copy this file to .env and provide your actual API keys

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_ORIGINS=https://securevault-ai-two.vercel.app,http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
